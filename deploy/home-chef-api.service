[Unit]
Description=Home Chef API
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=homechef
WorkingDirectory=/srv/home-chef
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --env-file=/srv/home-chef/.env apps/api/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=75
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target