{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "node",
      "@tarojs/taro"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*",
    "config/**/*"
  ]
}