APP_MODE=business
DATABASE_URL=postgresql://home_chef:home_chef@localhost:55432/home_chef_business
REDIS_URL=redis://localhost:56379
PORT=3000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
API_URL=http://127.0.0.1:3000
WORKER_ENABLED=true
DATA_KEY=GENERATE_64_HEX_CHARACTERS
INTERNAL_JOB_SECRET=GENERATE_64_HEX_CHARACTERS
DEMO_PASSWORD=HomeChefDemo2026!
TZ=Asia/Shanghai

# Tencent location-picker browser key (public, restrict authorized domains); never use a server secret.
TENCENT_MAP_BROWSER_KEY=
TENCENT_MAP_REFERER=home-chef

ADMIN_BOOTSTRAP_USERNAME=operator
ADMIN_BOOTSTRAP_PASSWORD=GENERATE_64_HEX_CHARACTERS

# WeChat Pay APIv3 (ordinary merchant, Mini Program). Keep disabled until configured.
WECHAT_PAY_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL=
WECHAT_MCH_PRIVATE_KEY_PATH=
WECHAT_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
# Public HTTPS API domain registered in the Mini Program console.
TARO_APP_API_BASE=
# Chef finance: approval-gated merchant transfers, disabled until granted by WeChat.
CHEF_SETTLEMENT_HOLD_HOURS=168
WECHAT_TRANSFER_ENABLED=false
WECHAT_TRANSFER_SCENE_ID=
# Single-quote valid JSON for shell sourcing; use the actual approved scene fields.
WECHAT_TRANSFER_SCENE_REPORTS='[]'
WECHAT_TRANSFER_MAX_FEN=200000
# New orders only. Direct sharing and wallet withdrawal never pay the same income twice.
WECHAT_PROFITSHARING_ENABLED=false
# Actual maximum ratio approved in merchant console, e.g. 0.9 only if approved.
WECHAT_PROFITSHARING_MAX_RATIO=
# Enable only behind the loopback reverse proxy; keep HOST=127.0.0.1.
TRUST_LOCAL_PROXY=false

# Mini Program phone login is independent of merchant payment configuration.
WECHAT_LOGIN_ENABLED=false
